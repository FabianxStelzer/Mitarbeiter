generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

enum UserRole {
  CANDIDATE
  COMPANY
}

enum VisibilityStatus {
  ACTIVE_SEARCH
  OPEN_TO_OFFERS
  HIDDEN
}

enum VerificationStatus {
  UNVERIFIED
  PENDING
  VERIFIED
}

enum ContactStatus {
  PENDING
  ACCEPTED
  DECLINED
}

enum ApplicationStage {
  APPLIED
  INVITED
  INTERVIEWS
  HIRED
  REJECTED
}

enum MessageSenderRole {
  CANDIDATE
  COMPANY
}

model User {
  id            String          @id @default(cuid())
  email         String          @unique
  passwordHash  String
  role          UserRole
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  candidate     CandidateProfile?
  company       CompanyProfile?
}

model CandidateProfile {
  id                          String           @id @default(cuid())
  userId                      String           @unique
  firstName                   String
  lastName                    String
  phone                       String?
  avatarUrl                   String?
  location                    String?
  headline                    String?
  summary                     String?
  currentEmployer             String?
  hideFromCurrentEmployer     Boolean          @default(true)
  visibility                  VisibilityStatus @default(OPEN_TO_OFFERS)
  salaryMin                   Int?
  salaryMax                   Int?
  currency                    String           @default("EUR")
  availableFrom               DateTime?
  availabilityNote            String?
  experienceYears             Int              @default(0)
  skillsJson                  String           @default("[]")
  experiencesJson             String           @default("[]")
  educationsJson              String           @default("[]")
  certificatesJson            String           @default("[]")
  portfolioJson               String           @default("[]")
  preferredLocationsJson      String           @default("[]")
  preferredEmploymentTypesJson String          @default("[]")
  blockedCompanyIdsJson       String           @default("[]")
  blockedManagerEmailsJson    String           @default("[]")
  gdprConsentAt               DateTime?
  createdAt                   DateTime         @default(now())
  updatedAt                   DateTime         @updatedAt
  user                        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  favorites                   FavoriteCandidate[]
  contactRequests             ContactRequest[]
  applications                Application[]
  messageThreads              MessageThread[]   @relation("CandidateThreads")
}

model CompanyProfile {
  id                   String             @id @default(cuid())
  userId               String             @unique
  companyName          String
  legalName            String?
  location             String?
  industry             String?
  website              String?
  description          String?
  verificationStatus   VerificationStatus @default(UNVERIFIED)
  managingDirectorEmail String?
  employeeCount        Int?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  user                 User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobs                 JobPosting[]
  favorites            FavoriteCandidate[]
  contactRequests      ContactRequest[]
  applications         Application[]
  messageThreads       MessageThread[]    @relation("CompanyThreads")
}

model JobPosting {
  id                 String         @id @default(cuid())
  companyProfileId   String
  title              String
  description        String?
  location           String?
  isRemote           Boolean        @default(false)
  salaryMin          Int?
  salaryMax          Int?
  currency           String         @default("EUR")
  minExperienceYears Int            @default(0)
  requiredSkillsJson String         @default("[]")
  preferredSkillsJson String        @default("[]")
  availabilityNote   String?
  active             Boolean        @default(true)
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  company            CompanyProfile @relation(fields: [companyProfileId], references: [id], onDelete: Cascade)
  contactRequests    ContactRequest[]
  applications       Application[]
}

model FavoriteCandidate {
  id                 String           @id @default(cuid())
  companyProfileId   String
  candidateProfileId String
  createdAt          DateTime         @default(now())
  company            CompanyProfile   @relation(fields: [companyProfileId], references: [id], onDelete: Cascade)
  candidate          CandidateProfile @relation(fields: [candidateProfileId], references: [id], onDelete: Cascade)

  @@unique([companyProfileId, candidateProfileId])
}

model ContactRequest {
  id                 String           @id @default(cuid())
  companyProfileId   String
  candidateProfileId String
  jobPostingId       String?
  message            String
  status             ContactStatus    @default(PENDING)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  company            CompanyProfile   @relation(fields: [companyProfileId], references: [id], onDelete: Cascade)
  candidate          CandidateProfile @relation(fields: [candidateProfileId], references: [id], onDelete: Cascade)
  jobPosting         JobPosting?      @relation(fields: [jobPostingId], references: [id], onDelete: SetNull)
}

model Application {
  id                 String           @id @default(cuid())
  candidateProfileId String
  companyProfileId   String
  jobPostingId       String
  stage              ApplicationStage @default(APPLIED)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  candidate          CandidateProfile @relation(fields: [candidateProfileId], references: [id], onDelete: Cascade)
  company            CompanyProfile   @relation(fields: [companyProfileId], references: [id], onDelete: Cascade)
  jobPosting         JobPosting       @relation(fields: [jobPostingId], references: [id], onDelete: Cascade)
  thread             MessageThread?

  @@unique([candidateProfileId, jobPostingId])
}

model MessageThread {
  id                 String           @id @default(cuid())
  candidateProfileId String
  companyProfileId   String
  applicationId      String?          @unique
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  candidate          CandidateProfile @relation("CandidateThreads", fields: [candidateProfileId], references: [id], onDelete: Cascade)
  company            CompanyProfile   @relation("CompanyThreads", fields: [companyProfileId], references: [id], onDelete: Cascade)
  application        Application?     @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  messages           Message[]

  @@index([candidateProfileId, companyProfileId])
}

model Message {
  id         String            @id @default(cuid())
  threadId   String
  senderRole MessageSenderRole
  senderUserId String
  content    String
  createdAt  DateTime          @default(now())
  readAt     DateTime?
  thread     MessageThread     @relation(fields: [threadId], references: [id], onDelete: Cascade)
}
